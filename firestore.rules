rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTeamMember == true
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamOwnerUid == userId));
      // Round-16 (CodeRabbit re-review - CRITICAL): freeze isTeamMember
      // and teamOwnerUid on self-update. Without these constraints, a
      // signed-in user can self-assign isTeamMember=true and
      // teamOwnerUid=<victim>, then satisfy every downstream team-member
      // read rule (this rule, the avatars/projects/workspaces subcollections,
      // the FR-023 server-side guards) by pointing at a user who never
      // invited them. Both fields are server-managed: isTeamMember is set
      // by the workspace owner via a Cloud Function, teamOwnerUid is
      // set the same way. Only credits and plan are user-modifiable in
      // the existing rule; the team-membership fields are now locked.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.credits <= resource.data.credits
                    && request.resource.data.plan == resource.data.plan
                    && request.resource.data.isTeamMember == resource.data.isTeamMember
                    && request.resource.data.teamOwnerUid == resource.data.teamOwnerUid;
      // Round-17 (CodeRabbit re-review): the prior allow create rule only
      // verified that the writer is the authed uid. The isTeamMember /
      // teamOwnerUid update lock from Round-16 prevents the user from
      // ESCALATING those fields post-create, but a user could still CREATE
      // the doc with isTeamMember=true and teamOwnerUid=<victim> on day
      // one. The create rule must require the new doc to start with the
      // unaffiliated defaults — isTeamMember=false and teamOwnerUid
      // absent/null. Both fields are server-managed (set by the workspace
      // owner via a Cloud Function); the client should never be able to
      // mint either. Together with the Round-16 update lock this closes
      // both the create-time and update-time self-elevation paths.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.isTeamMember == false
                    && (request.resource.data.teamOwnerUid == null
                        || !('teamOwnerUid' in request.resource.data));

      // Avatars subcollection — owner + team members
      match /avatars/{avatarId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if request.auth != null
                          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTeamMember == true
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamOwnerUid == userId;
      }

      // Projects subcollection — owner + team members
      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if request.auth != null
                          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTeamMember == true
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamOwnerUid == userId;
      }

      // Workspaces subcollection (Multi-Brand — Scale only) — owner + team members.
      // Coarse-grained: team members of the owner can read any active workspace under that owner.
      //
      // ISSUE-D (spec 965) removed per-member `workspaceAccess` narrowing. A verified
      // team member now reaches EVERY active workspace of their owner (FR-004); the
      // stored per-member array is retained but never consulted for authorization
      // (FR-021) — it is read only to emit the FR-004b override trace. Do not look
      // for allowlist enforcement downstream: there is none.
      //
      // The three-layer defense is now:
      //   1. these rules          — membership + owner match + not soft-deleted
      //   2. server callables     — `getWorkspaceGenerations` resolves the caller's
      //                             account via `resolveCallerScope` and compares it
      //                             against the workspace owner, so a stale membership
      //                             doc under another account grants nothing; all six
      //                             guarded mutation callables refuse team members
      //                             outright via `assertNotTeamMember` —
      //                             createWorkspace, updateWorkspace, deleteWorkspace,
      //                             restoreWorkspace, linkMetaAccountToWorkspace,
      //                             unlinkMetaAccountFromWorkspace
      //   3. the frontend switcher — withholds create / edit / delete controls
      // Soft-deleted workspaces are hidden from team-member reads; owners
      // retain direct access below.
      // The Phase 14 adAccounts subtree is declared in a separate match
      // block further down (re-uses `isWorkspaceMember` helper).
      match /workspaces/{workspaceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null
                          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTeamMember == true
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamOwnerUid == userId
                          && resource.data.deletedAt == null;
      }

      // Workspace access audit — owner only, immutable
      match /workspace_access_audit/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // ═══════════════════════════════════════════════════════════
      // Phase 14 — RAG + Meta Reporting Feedback Loop (Layer 1+)
      // Workspace-scoped subcollections. Owner `userId` + workspace
      // membership. Server-only writes on `private/**` (Meta tokens).
      // ═══════════════════════════════════════════════════════════

      // Workspaces subcollection (declared again above with broader read
      // access). The Phase 14 adAccounts subtree below reuses
      // `isWorkspaceMember` defined further down.
      // Phase 14 adAccounts subtree (Layer 1+: Funnel Settings, sync
      // snapshots, ad performance + verdicts, baselines, hook + visual
      // aggregates).
      match /workspaces/{workspaceId} {

        // ── adAccounts subtree (per-workspace-account data) ──
        match /adAccounts/{accountId} {
          allow read, write: if isWorkspaceMember(userId, workspaceId);
          // Sub-paths:
          //   settings/current                    (Layer 1 — Funnel Settings, user-writable, single-doc contract)
          //   syncSnapshots/{snapshotId}          (Layer 2 — server-writable)
          //   adPerformance/{adId}                (Layer 2 — server-writable)
          //   baselines/{docId}                   (Layer 4 — server-writable)
          //   hookPerformance/{angleKey}          (Layer 4b — server-writable)
          //   visualPerformance/{patternKey}      (Layer 4b — server-writable)
          // The funnel-settings subtree is a single document at
          // `settings/current` — the contract is fixed at that literal
          // path. A wildcard here would let a user write any sibling doc
          // (e.g. `settings/private_metadata`), bypassing the callable.
          match /settings/current {
            allow read, write: if isWorkspaceMember(userId, workspaceId);
          }
          match /syncSnapshots/{snapshotId} {
            allow read: if isWorkspaceMember(userId, workspaceId);
            allow write: if false; // Cloud Functions only
          }
          match /adPerformance/{adId} {
            allow read: if isWorkspaceMember(userId, workspaceId);
            allow write: if false; // Cloud Functions only
          }
          match /baselines/{docId} {
            allow read: if isWorkspaceMember(userId, workspaceId);
            allow write: if false; // Cloud Functions only
          }
          match /hookPerformance/{angleKey} {
            allow read: if isWorkspaceMember(userId, workspaceId);
            allow write: if false; // Cloud Functions only
          }
          match /visualPerformance/{patternKey} {
            allow read: if isWorkspaceMember(userId, workspaceId);
            allow write: if false; // Cloud Functions only
          }
        }

        // ── imageFingerprints subtree (Layer 3 — workspace-scoped
        //    perceptual-hash index). Server never reads by doc id; client
        //    writes both the doc and the parent generation's
        //    `imageFingerprint` field after `addDoc`.
        match /imageFingerprints/{hash} {
          allow read, write: if isWorkspaceMember(userId, workspaceId);
        }

        // ── private subtree (Layer 2 — Meta connection + token) ──
        // SERVER-ONLY. Deny all client access. The Cloud Functions Admin
        // SDK bypasses these rules entirely.
        match /private/{document=**} {
          allow read, write: if false;
        }
      }

      // Team subcollection — only the owner can read their team list
      // Writes are handled by Cloud Functions (createTeamMember / removeTeamMember)
      match /team/{memberId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Helper function: returns true when the caller is the owner `userId`
    // or a team member of `userId` AND the workspace exists and is not
    // soft-deleted (`deletedAt == null`). Without this check, any
    // well-formed call to a subcollection rule (e.g. `adAccounts/{id}`)
    // would pass with an arbitrary `workspaceId` — defeating the
    // coarse-grained per-workspace allowlist below.
    function isWorkspaceMember(userId, workspaceId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceId))
          && get(/databases/$(database)/documents/users/$(userId)/workspaces/$(workspaceId)).data.deletedAt == null
          && (request.auth.uid == userId
              || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTeamMember == true
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamOwnerUid == userId));
    }

    // Principle Vault — AI learning system. Cloud Functions write, user reads.
    match /principleVaults/{userId}/principles/{principleId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only Cloud Functions can write
    }

    // Team membership reverse-lookup — a user can only read their own membership doc
    // Writes are handled by Cloud Functions only
    match /teamMemberships/{email} {
      allow read: if request.auth != null
                  && request.auth.token.email == email;
      allow write: if false;
    }

    // Pending plans — created by backend webhook for users who haven't signed in yet
    // User can only read/delete their own pending plan (keyed by email)
    match /pending_plans/{email} {
      allow read, delete: if request.auth != null
                          && request.auth.token.email == email;
      allow create, update: if false;
    }

    // Stripe event idempotency — written by Cloud Functions only
    match /stripe_events/{eventId} {
      allow write: if false;
      allow read: if false;
    }

    // Cancellation logs — written by Cloud Functions and client (reason dialog)
    // The owning user MAY read their own entries
    match /cancellation_logs/{logId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Refund logs — admin-only writes (Cloud Functions Admin SDK; no client writes)
    // The owning user MAY read their own entries
    match /refund_logs/{logId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Generations collection (feedback system)
    match /generations/{genId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Ad Performance collection (Meta sync — written by Cloud Functions only)
    match /adPerformance/{perfId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Pushed Creatives linkage (tracks which generation was pushed to Meta)
    match /pushedCreatives/{pushId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Creative Deployments (durable attribution — written by Cloud Functions, read by client)
    match /creativeDeployments/{depId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions can write
    }

    // Ad Performance History (time-aware snapshots — written by Cloud Functions, read by client)
    match /adPerformanceHistory/{snapId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions can write
    }

    // User Preferences (personalization — written and read by the user)
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}